{
  "name": "agent-canvas",
  "productName": "Agent Canvas",
  "version": "0.7.0",
  "description": "Canvas para orquestrar agentes de IA (Maestro e Agentes) em terminais conectados.",
  "author": "Agent Canvas",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "icons": "node build/make-icons.cjs",
    "test": "node --test --test-concurrency=1 --test-timeout=300000 \"test/*.test.mjs\"",
    "test:unit": "node --test --test-timeout=120000 test/activity.test.mjs test/agentusage.test.mjs test/backup.test.mjs test/diagnose.test.mjs test/geometry.test.mjs test/git.test.mjs test/history.test.mjs test/inputlog.test.mjs test/launch.test.mjs test/ledger.test.mjs test/pipeline.test.mjs test/pipelinerunner.test.mjs test/proc.test.mjs test/remote.test.mjs test/routines.test.mjs test/schedule.test.mjs test/status.test.mjs test/teams.test.mjs",
    "test:smoke": "node --test --test-timeout=300000 test/smoke.test.mjs",
    "release": "vite build && electron-builder --win nsis --x64 --publish always \"--config.directories.output=%LOCALAPPDATA%\\agent-canvas-release\"",
    "dist": "vite build && electron-builder --win nsis --x64 \"--config.directories.output=%LOCALAPPDATA%\\agent-canvas-release\""
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xyflow/react": "^12.12.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.57.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.agentcanvas.app",
    "productName": "Agent Canvas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "bin/**",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "jvyctor",
        "repo": "agent-canvas-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Canvas",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Agent-Canvas-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "artifactName": "Agent-Canvas-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Agent Canvas",
      "synopsis": "Canvas para orquestrar agentes de IA"
    },
    "appImage": {
      "artifactName": "Agent-Canvas-${version}.${ext}"
    },
    "deb": {
      "artifactName": "Agent-Canvas-${version}.${ext}"
    }
  }
}
